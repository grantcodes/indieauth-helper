{
  "name": "indieauth-helper",
  "version": "1.0.2",
  "description": "A simple helper class for creating IndieAuth clients",
  "keywords": [
    "indieauth",
    "indieweb",
    "oauth",
    "pkce"
  ],
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    }
  },
  "files": [
    "dist/**/*",
    "!**/*.test.*",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "homepage": "https://grantcodes.github.io/indieauth-helper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grantcodes/indieauth-helper.git"
  },
  "bugs": "https://github.com/grantcodes/indieauth-helper/issues",
  "author": "Grant Richmond <mail@grant.codes> (https://grant.codes)",
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "lint": "biome check src",
    "fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test:build": "tsup --env.TEST=yes",
    "test": "npm run lint && npm run typecheck && npm run test:build && node --test tmp/tests",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run check:package"
  },
  "dependencies": {
    "rel-parser": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
